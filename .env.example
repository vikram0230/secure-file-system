# Copy to .env and fill in real values for your machine; never commit .env.
# Generate a secret with: openssl rand -hex 32
SFS_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/sfs
SFS_SECRET_KEY=<generate-with-openssl-rand--hex-32>
SFS_STORAGE_NODES=localhost:9001,localhost:9002,localhost:9003,localhost:9004,localhost:9005,localhost:9006
SFS_SHARD_DATA_COUNT=4
SFS_SHARD_PARITY_COUNT=2
