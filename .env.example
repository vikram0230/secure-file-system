# Copy to .env and fill in real values; never commit .env.
# Generate each secret with: openssl rand -hex 32
# (hex keeps secrets URL-safe inside SFS_DATABASE_URL)
#
# docker-compose reads this file for variable substitution and passes each
# container only the variables it needs (see docker-compose.yml).

# --- Postgres container ---
POSTGRES_USER=sfs
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=sfs

# --- API service, when run directly on the host ---
SFS_DATABASE_URL=postgresql+psycopg://sfs:<POSTGRES_PASSWORD>@localhost:5432/sfs
SFS_SECRET_KEY=<generate>

# --- Shared by the API service and every storage node ---
SFS_NODE_TOKEN=<generate>

# --- scripts/seed_storage_nodes.py, when run on the host ---
SFS_STORAGE_NODES=localhost:9001,localhost:9002,localhost:9003,localhost:9004,localhost:9005,localhost:9006
