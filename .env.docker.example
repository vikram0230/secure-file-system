# Used by docker-compose (docker-compose.yml env_file: .env.docker).
# Copy to .env.docker and adjust; never commit the real .env.docker.

POSTGRES_USER=sfs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sfs

SFS_DATABASE_URL=postgresql+psycopg://sfs:change-me@postgres:5432/sfs
SFS_SECRET_KEY=change-me
SFS_STORAGE_NODES=storage-node-1:8000,storage-node-2:8000,storage-node-3:8000,storage-node-4:8000,storage-node-5:8000,storage-node-6:8000
SFS_SHARD_DATA_COUNT=4
SFS_SHARD_PARITY_COUNT=2

SFS_NODE_SHARD_DIR=/data
